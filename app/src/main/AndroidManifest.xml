<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nécessaire pour lister les applications installées (sélecteur d'app cible) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Internet : optionnel, prévu pour une future synchronisation cloud -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Déclare l'application comme compatible TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Masque le requisit tactile pour les appareils TV -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".KeyBinderTvApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">

            <!-- Intent standard Android -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent TV : nécessaire pour apparaître dans le launcher Android TV / Google TV -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Le service AccessibilityService sera déclaré en Phase 2 -->

    </application>

</manifest>
